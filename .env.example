# Copy this file to .env and adjust values. Never commit .env.

# PostgreSQL connection (SQLAlchemy URL). Create the database first, e.g.:
#   createdb fmip
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/fmip

# Ingestion window. End date is optional (blank = today).
DEFAULT_START_DATE=2018-01-01
DEFAULT_END_DATE=

# Analysis parameters
RISK_FREE_RATE=0.04          # annual rate, e.g. 0.04 = 4%
ZSCORE_THRESHOLD=3.0         # |z| at or above this is flagged
ROLLING_WINDOW=60            # sessions in the rolling baseline (minimum 20)
ISOLATION_CONTAMINATION=0.01 # expected share of flagged days for Isolation Forest

LOG_LEVEL=INFO
